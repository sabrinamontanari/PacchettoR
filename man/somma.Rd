\name{somma}
\alias{somma}
\title{Sum of Two Numbers}
\description{
Computes the sum of two numeric values.
}
\usage{
somma(x, y)
}
\arguments{
  \item{x}{
    A numeric value.
  }
  \item{y}{
    A numeric value to be added to \code{x}.
  }
}
\details{
The function adds the two inputs and returns the result.
It is equivalent to using the \code{+} operator directly,
but can be useful for demonstration or abstraction purposes.
}
\value{
A numeric value equal to the sum of \code{x} and \code{y}.
}
\examples{
somma(73, 837)
somma(1.5, 2.3)
}
\author{
Your Name
}
